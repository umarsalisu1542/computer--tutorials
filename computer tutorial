  </div>
</section>

<!-- ============================================================ -->
<!-- PAGE: ADMIN LOGIN -->
<!-- ============================================================ -->
<section id="page-login" class="page hidden">
  <div class="section-title">
    <h2>🔐 Admin Login</h2>
    <p>Enter your credentials to manage tutorials</p>
  </div>

  <div class="auth-box">
    <label style="font-weight:600;">Email</label>
    <input type="email" id="adminEmail" placeholder="admin@yourdomain.com" value="admin@yourdomain.com" />

    <label style="font-weight:600;">Password</label>
    <input type="password" id="adminPassword" placeholder="••••••••" value="SecurePass123" />

    <button class="btn" onclick="adminLogin()" style="width:100%;">Login</button>

    <p style="margin-top:15px;text-align:center;color:#888;font-size:13px;">
      Default: admin@yourdomain.com / SecurePass123
    </p>
  </div>
</section>

<!-- ============================================================ -->
<!-- PAGE: ADMIN DASHBOARD -->
<!-- ============================================================ -->
<section id="page-admin" class="page hidden">
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:15px;margin-bottom:25px;">
    <div>
      <h2 style="font-size:28px;">📊 Admin Dashboard</h2>
      <p style="color:#666;">Manage your tutorials</p>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
      <button class="btn btn-success" onclick="toggleAddForm()">+ Add Tutorial</button>
      <button class="btn btn-danger" onclick="adminLogout()">Logout</button>
    </div>
  </div>

  <!-- Add Tutorial Form -->
  <div id="addForm" class="admin-panel hidden" style="margin-bottom:30px;">
    <h3 style="margin-bottom:18px;">✏️ New Tutorial</h3>
    <label>Subject</label>
    <select id="tSubject">
      <option value="Python">Python</option>
      <option value="JavaScript">JavaScript</option>
      <option value="Java">Java</option>
      <option value="C++">C++</option>
      <option value="Networking">Networking</option>
      <option value="Database">Database</option>
      <option value="Web Development">Web Development</option>
      <option value="Other">Other</option>
    </select>

    <label>Title</label>
    <input type="text" id="tTitle" placeholder="e.g. Python Functions Explained" />

    <label>Description</label>
    <input type="text" id="tDesc" placeholder="Short description of this tutorial" />

    <label>YouTube URL</label>
    <input type="text" id="tVideo" placeholder="https://youtu.be/... or https://www.youtube.com/watch?v=..." />

    <label>Difficulty</label>
    <select id="tDifficulty">
      <option value="Beginner">Beginner</option>
      <option value="Intermediate">Intermediate</option>
      <option value="Advanced">Advanced</option>
    </select>

    <label>Content / Notes (HTML supported)</label>
    <textarea id="tContent" placeholder="Write your tutorial notes here. You can use HTML tags like &lt;h1&gt;, &lt;p&gt;, &lt;ul&gt;..."></textarea>

    <div style="display:flex;gap:12px;flex-wrap:wrap;">
      <button class="btn btn-success" onclick="saveTutorial()">Publish Tutorial</button>
      <button class="btn btn-danger" onclick="toggleAddForm()">Cancel</button>
    </div>
  </div>

  <!-- Tutorials Table -->
  <div class="admin-panel">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Subject</th>
            <th>Difficulty</th>
            <th style="text-align:center;">Actions</th>
          </tr>
        </thead>
        <tbody id="adminTableBody">
          <!-- Rendered by JavaScript -->
        </tbody>
      </table>
    </div>
    <p id="noTutorialsMsg" style="text-align:center;color:#888;padding:20px;">No tutorials yet. Add your first one!</p>
  </div>
</section>

<!-- ============================================================ -->
<!-- FOOTER -->
<!-- ============================================================ -->
<footer>
  <h3>💻 Computer Tutorials</h3>
  <p style="margin-top:8px;">Learn Today, Build Tomorrow.</p>
  <p style="margin-top:12px;font-size:13px;">© 2026 Computer Tutorials. All Rights Reserved.</p>
</footer>

<!-- ============================================================ -->
<!-- TOAST CONTAINER -->
<!-- ============================================================ -->
<div id="toastContainer"></div>
  <script>
    // ================================================================
    // DATA (stored in localStorage)
    // ================================================================

    function getTutorials() {
      const data = localStorage.getItem('tutorials');
      return data ? JSON.parse(data) : [];
    }

    function setTutorials(data) {
      localStorage.setItem('tutorials', JSON.stringify(data));
    }

    function getAdmin() {
      return localStorage.getItem('adminLoggedIn') === 'true';
    }

    function setAdmin(status) {
      localStorage.setItem('adminLoggedIn', String(status));
    }

    // ================================================================
    // SEED: Add some example tutorials
    // ================================================================

    function seedTutorials() {
      const existing = getTutorials();
      if (existing.length > 0) return;

      const sample = [{
        id: Date.now() + 1,
        subject: 'Python',
        title: 'Python for Beginners',
        description: 'Learn Python from scratch with practical examples.',
        videoUrl: 'https://youtu.be/kqtD5dpn9C8',
        difficulty: 'Beginner',
        content: '<h2>Welcome to Python!</h2><p>Python is a great first language.</p><ul><li>Easy syntax</li><li>Huge community</li><li>Many job opportunities</li></ul>',
        thumbnail: 'https://img.youtube.com/vi/kqtD5dpn9C8/mqdefault.jpg',
        createdAt: new Date().toISOString()
      }, {
        id: Date.now() + 2,
        subject: 'JavaScript',
        title: 'JavaScript ES6 Essentials',
        description: 'Modern JavaScript features you need to know.',
        videoUrl: 'https://youtu.be/W6NZfCO5SIk',
        difficulty: 'Intermediate',
        content: '<h2>ES6 Features</h2><p>Arrow functions, destructuring, spread operator, and more.</p>',
        thumbnail: 'https://img.youtube.com/vi/W6NZfCO5SIk/mqdefault.jpg',
        createdAt: new Date().toISOString()
      }, {
        id: Date.now() + 3,
        subject: 'Networking',
        title: 'Computer Networks Explained',
        description: 'Understand how the internet works.',
        videoUrl: 'https://youtu.be/keeqnciDVOY',
        difficulty: 'Beginner',
        content: '<h2>What is a Network?</h2><p>A network connects devices together.</p>',
        thumbnail: 'https://img.youtube.com/vi/keeqnciDVOY/mqdefault.jpg',
        createdAt: new Date().toISOString()
      }];

      setTutorials(sample);
    }

    // ================================================================
    // EXTRACT YOUTUBE THUMBNAIL
    // ================================================================

    function extractYouTubeId(url) {
      if (!url) return null;
      const regex = /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([^&\n?#]+)/;
      const match = url.match(regex);
      return match ? match[1] : null;
    }

    function getYouTubeThumbnail(url) {
      const id = extractYouTubeId(url);
      return id ? `https://img.youtube.com/vi/${id}/mqdefault.jpg` : '';
    }

    // ================================================================
    // RENDER FUNCTIONS
    // ================================================================

    function renderCourses() {
      const container = document.getElementById('coursesContainer');
      const search = document.getElementById('searchInput').value.toLowerCase();
      const tutorials = getTutorials();

      let filtered = tutorials;
      if (search) {
        filtered = tutorials.filter(t =>
          t.title.toLowerCase().includes(search) ||
          t.description.toLowerCase().includes(search) ||
          t.subject.toLowerCase().includes(search)
        );
      }

      if (filtered.length === 0) {
        container.innerHTML = `<p style="text-align:center;color:#888;grid-column:1/-1;padding:40px;">No tutorials found. Check back soon!</p>`;
        return;
      }

      container.innerHTML = filtered.map(t => `
        <div class="course-card">
          <img src="${t.thumbnail || 'https://via.placeholder.com/640x360/0b5ed7/ffffff?text=Computer+Tutorial'}" 
               alt="${t.title}"
               onerror="this.src='https://via.placeholder.com/640x360/0b5ed7/ffffff?text=Computer+Tutorial'" />
          <div class="body">
            <div style="margin-bottom:8px;">
              <span class="badge badge-blue">${t.subject}</span>
              <span class="badge ${t.difficulty === 'Beginner' ? 'badge-green' : t.difficulty === 'Intermediate' ? 'badge-yellow' : 'badge-red'}">${t.difficulty}</span>
            </div>
            <h3>${t.title}</h3>
            <p>${t.description}</p>
            <button class="btn" onclick="watchTutorial('${t.id}')" style="font-size:13px;padding:8px 16px;">
              ▶ Watch
            </button>
          </div>
        </div>
      `).join('');
    }

    function renderAdminTable() {
      const tbody = document.getElementById('adminTableBody');
      const tutorials = getTutorials();
      const msg = document.getElementById('noTutorialsMsg');

      if (tutorials.length === 0) {
        tbody.innerHTML = '';
        msg.style.display = 'block';
        return;
      }
      msg.style.display = 'none';

      tbody.innerHTML = tutorials.map(t => `
        <tr>
          <td><strong>${t.title}</strong></td>
          <td>${t.subject}</td>
          <td>${t.difficulty}</td>
          <td style="text-align:center;">
            <div class="table-actions" style="justify-content:center;">
                  <button class="btn btn-warning" onclick="watchTutorial('${t.id}')" style="padding:4px 12px;font-size:11px;">View</button>
              <button class="btn btn-danger" onclick="deleteTutorial('${t.id}')" style="padding:4px 12px;font-size:11px;">Delete</button>
            </div>
          </td>
        </tr>
      `).join('');
    }

    // ================================================================
    // PAGE NAVIGATION
    // ================================================================

    function showPage(page) {
      document.querySelectorAll('.page').forEach(el => el.classList.add('hidden'));
      const target = document.getElementById('page-' + page);
      if (target) target.classList.remove('hidden');

      if (page === 'admin') {
        if (!getAdmin()) {
          showPage('login');
          showToast('Please login first', 'error');
          return;
        }
        renderAdminTable();
      }

      if (page === 'courses') {
        renderCourses();
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // ================================================================
    // ADMIN LOGIN / LOGOUT
    // ================================================================

    function adminLogin() {
  const email = document.getElementById('adminEmail').value;
  const password = document.getElementById('adminPassword').value;

  if (email === 'umarsalisu1542@gmail.com' && password === 'umar@1542') {
    setAdmin(true);
    showToast('✅ Login successful!', 'success');
    showPage('admin');
  } else {
    showToast('❌ Invalid credentials. Try again.', 'error');
  }
    }
    function adminLogout() {
      setAdmin(false);
      showToast('Logged out', 'success');
      showPage('home');
    }

    // ================================================================
    // ADD / DELETE TUTORIALS
    // ================================================================

    function toggleAddForm() {
      const form = document.getElementById('addForm');
      form.classList.toggle('hidden');
      if (!form.classList.contains('hidden')) {
        document.getElementById('tTitle').focus();
      }
    }

    function saveTutorial() {
      const title = document.getElementById('tTitle').value.trim();
      const description = document.getElementById('tDesc').value.trim();
      const videoUrl = document.getElementById('tVideo').value.trim();
      const subject = document.getElementById('tSubject').value;
      const difficulty = document.getElementById('tDifficulty').value;
      const content = document.getElementById('tContent').value.trim();

      if (!title || !description || !videoUrl || !content) {
        showToast('⚠️ Please fill in all fields', 'error');
        return;
      }

      const tutorials = getTutorials();
      const newTut = {
        id: Date.now(),
        subject,
        title,
        description,
        videoUrl,
        difficulty,
        content,
        thumbnail: getYouTubeThumbnail(videoUrl),
        createdAt: new Date().toISOString()
      };

      tutorials.unshift(newTut);
      setTutorials(tutorials);

      document.getElementById('tTitle').value = '';
      document.getElementById('tDesc').value = '';
      document.getElementById('tVideo').value = '';
      document.getElementById('tContent').value = '';

      showToast('✅ Tutorial published!', 'success');
      renderAdminTable();
      renderCourses();
      toggleAddForm();
    }

    function deleteTutorial(id) {
      if (!confirm('Are you sure you want to delete this tutorial?')) return;

      let tutorials = getTutorials();
      tutorials = tutorials.filter(t => t.id != id);
      setTutorials(tutorials);

      showToast('🗑️ Tutorial deleted', 'success');
      renderAdminTable();
      renderCourses();
    }

    function watchTutorial(id) {
      const tutorials = getTutorials();
      const tut = tutorials.find(t => t.id == id);
      if (!tut) {
        showToast('Tutorial not found', 'error');
        return;
      }

      const videoId = extractYouTubeId(tut.videoUrl);
      if (videoId) {
        window.open(`https://www.youtube.com/watch?v=${videoId}`, '_blank');
      } else {
        alert(`📚 ${tut.title}\n\nSubject: ${tut.subject}\nDifficulty: ${tut.difficulty}\n\n${tut.description}\n\nVideo URL: ${tut.videoUrl}\n\n📝 Notes:\n${tut.content.replace(/<[^>]*>/g, '\n')}`);
      }
    }

    // ================================================================
    // TOAST NOTIFICATIONS
    // ================================================================

    function showToast(message, type = 'success') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      toast.className = `toast toast-${type}`;
      toast.textContent = message;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transition = 'opacity 0.5s';
        setTimeout(() => toast.remove(), 500);
      }, 3000);
    }

    // ================================================================

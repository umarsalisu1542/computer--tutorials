<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>💻 Computer Tutorials</title>

  <style>
    /* ===== RESET & BASE ===== */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background: #f0f4f8;
      color: #1a2332;
    }

    /* ===== HEADER ===== */
    header {
      background: #0b5ed7;
      color: white;
      padding: 16px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 1000;
      flex-wrap: wrap;
      gap: 10px;
    }

    .logo {
      font-size: 24px;
      font-weight: bold;
    }
    .logo span {
      font-size: 12px;
      font-weight: normal;
      display: block;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 15px;
      flex-wrap: wrap;
    }
    nav a {
      color: white;
      text-decoration: none;
      font-size: 14px;
      cursor: pointer;
    }
    nav a:hover {
      text-decoration: underline;
    }

    .btn {
      display: inline-block;
      padding: 10px 22px;
      background: #0b5ed7;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      font-size: 14px;
      transition: background 0.3s;
    }
    .btn:hover {
      background: #084298;
    }
    .btn-danger {
      background: #dc3545;
    }
    .btn-danger:hover {
      background: #a71d2a;
    }
    .btn-success {
      background: #198754;
    }
    .btn-success:hover {
      background: #0d6e3f;
    }
    .btn-warning {
      background: #ffc107;
      color: #1a2332;
    }
    .btn-warning:hover {
      background: #e0a800;
    }

    /* ===== HERO ===== */
    .hero {
      min-height: 400px;
      padding: 60px 7%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
      background: linear-gradient(135deg, #eaf2ff, #ffffff);
      flex-wrap: wrap;
    }
    .hero-text {
      max-width: 550px;
    }
    .hero-text h1 {
      font-size: 42px;
      color: #0b5ed7;
      margin-bottom: 15px;
    }
    .hero-text p {
      font-size: 18px;
      line-height: 1.7;
      color: #555;
      margin-bottom: 20px;
    }

    .hero-card {
      background: white;
      padding: 35px;
      border-radius: 20px;
      box-shadow: 0 10px 35px rgba(0, 0, 0, 0.1);
      text-align: center;
      min-width: 250px;
    }
    .hero-card .icon {
      font-size: 70px;
    }

    /* ===== SECTIONS ===== */
    section {
      padding: 50px 7%;
    }
    .section-title {
      text-align: center;
      margin-bottom: 35px;
    }
    .section-title h2 {
      font-size: 30px;
      margin-bottom: 8px;
    }

    /* ===== COURSES GRID ===== */
    .courses-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 25px;
    }
    .course-card {
      background: white;
      border-radius: 15px;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.07);
      overflow: hidden;
      transition: transform 0.3s;
    }
    .course-card:hover {
      transform: translateY(-5px);
    }
    .course-card img {
      width: 100%;
      height: 170px;
      object-fit: cover;
      background: #0b5ed7;
    }
    .course-card .body {
      padding: 18px;
    }
    .course-card .body h3 {
      margin-bottom: 8px;
      font-size: 18px;
    }
    .course-card .body p {
      color: #666;
      font-size: 14px;
      line-height: 1.6;
      margin-bottom: 12px;
    }
    .course-card .badge {
      display: inline-block;
      font-size: 11px;
      padding: 3px 10px;
      border-radius: 20px;
      margin-right: 6px;
    }
    .badge-blue {
      background: #dbeafe;
      color: #1e40af;
    }
    .badge-green {
      background: #d1fae5;
      color: #065f46;
    }
    .badge-red {
      background: #fce4e4;
      color: #991b1b;
    }
    .badge-yellow {
      background: #fef3c7;
      color: #92400e;
    }

    /* ===== ADMIN PANEL ===== */
    .admin-panel {
      background: white;
      border-radius: 15px;
      padding: 30px;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
      max-width: 900px;
      margin: auto;
    }
    .admin-panel input,
    .admin-panel select,
    .admin-panel textarea {
      width: 100%;
      padding: 12px;
      margin-bottom: 14px;
      border: 1px solid #ddd;
      border-radius: 8px;
      font-size: 14px;
    }
    .admin-panel textarea {
      min-height: 120px;
      resize: vertical;
    }
    .admin-panel label {
      font-weight: 600;
      font-size: 14px;
      display: block;
      margin-bottom: 4px;
    }

    /* ===== TABLE ===== */
    .table-wrap {
      overflow-x: auto;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    th {
      background: #f8fafc;
      text-align: left;
      padding: 12px 15px;
      border-bottom: 2px solid #e2e8f0;
    }
    td {
      padding: 12px 15px;
      border-bottom: 1px solid #e2e8f0;
      vertical-align: middle;
    }
    .table-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .table-actions button {
      padding: 5px 12px;
      font-size: 12px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    /* ===== HIDDEN / SHOW ===== */
    .hidden {
      display: none !important;
    }

    /* ===== AUTH FORM ===== */
    .auth-box {
      max-width: 420px;
      margin: auto;
      background: white;
      padding: 35px;
      border-radius: 15px;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    }
    .auth-box input {
      width: 100%;
      padding: 12px;
      margin-bottom: 15px;
      border: 1px solid #ddd;
      border-radius: 8px;
    }

    /* ===== FOOTER ===== */
    footer {
      background: #111827;
      color: #9ca3af;
      text-align: center;
      padding: 30px;
      margin-top: 30px;
    }
    footer h3 {
      color: white;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 700px) {
      header {
        flex-direction: column;
        text-align: center;
      }
      nav {
        justify-content: center;
      }
      .hero {
        flex-direction: column;
        text-align: center;
      }
      .hero-text h1 {
        font-size: 32px;
      }
      .admin-panel {
        padding: 18px;
      }
    }

    /* ===== TOAST ===== */
    .toast {
      position: fixed;
      bottom: 30px;
      right: 30px;
      background: #1a2332;
      color: white;
      padding: 15px 25px;
      border-radius: 10px;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
      z-index: 9999;
      animation: slideUp 0.4s ease;
      max-width: 350px;
    }
    .toast-success {
      border-left: 5px solid #198754;
    }
    .toast-error {
      border-left: 5px solid #dc3545;
    }
    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>
<body>
<!-- ============================================================ -->
<!-- HEADER -->
<!-- ============================================================ -->
<header>
  <div class="logo">
    💻 CT
    <span>Computer Tutorials</span>
  </div>
  <nav>
    <a onclick="showPage('home')">Home</a>
    <a onclick="showPage('courses')">Courses</a>
    <a onclick="showPage('admin')">Admin</a>
    <a onclick="showPage('login')">Login</a>
  </nav>
</header>

<!-- ============================================================ -->
<!-- PAGE: HOME -->
<!-- ============================================================ -->
<section id="page-home" class="page">
  <div class="hero">
    <div class="hero-text">
      <h1>💻 Computer Tutorials</h1>
      <p>
        Learn programming, networking, databases, and more —
        completely free. Watch video tutorials and follow along
        with practical examples.
      </p>
      <button class="btn" onclick="showPage('courses')">Browse Courses →</button>
    </div>
    <div class="hero-card">
      <div class="icon">🎓</div>
      <h3>Start Learning</h3>
      <p style="color:#666;font-size:14px;">200+ students already enrolled</p>
      <button class="btn" onclick="showPage('courses')" style="margin-top:10px;">Get Started</button>
    </div>
  </div>

  <div style="text-align:center;padding:20px 0;">
    <h2 style="font-size:28px;">Featured Subjects</h2>
    <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:15px;margin-top:20px;">
      <span style="background:#dbeafe;padding:8px 20px;border-radius:30px;">🐍 Python</span>
      <span style="background:#fef3c7;padding:8px 20px;border-radius:30px;">🟨 JavaScript</span>
      <span style="background:#d1fae5;padding:8px 20px;border-radius:30px;">☕ Java</span>
      <span style="background:#fce4e4;padding:8px 20px;border-radius:30px;">🌐 Networking</span>
      <span style="background:#e0e7ff;padding:8px 20px;border-radius:30px;">🗄️ Database</span>
    </div>
  </div>
</section>

<!-- ============================================================ -->
<!-- PAGE: COURSES (Public) -->
<!-- ============================================================ -->
<section id="page-courses" class="page hidden">
  <div class="section-title">
    <h2>📚 All Tutorials</h2>
    <p>Watch, learn, and build your skills</p>
  </div>

  <div style="max-width:600px;margin:0 auto 30px;">
    <input
      type="text"
      id="searchInput"
      placeholder="🔍 Search tutorials..."
      oninput="renderCourses()"
      style="width:100%;padding:12px 18px;border:1px solid #ddd;border-radius:30px;font-size:16px;"
    />
  </div>

  <div id="coursesContainer" class="courses-grid">
